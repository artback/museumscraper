# MinIO/S3 connection (used by the Go apps running on the host)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# MinIO server credentials (used by the minio container itself)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Bucket holding both raw_data/ and enriched_data/
MUSEUM_BUCKET_NAME=museum

# Kafka: container-to-container bootstrap
KAFKA_BROKER=kafka:9092
# Kafka: host-to-container bootstrap, for Go apps run with `go run`.
# Both host endpoints use 127.0.0.1 rather than localhost: Docker publishes an
# IPv6 mapping that does not actually accept connections on macOS, and Go tries
# ::1 before 127.0.0.1.
KAFKA_BROKER_LOCAL=127.0.0.1:29092
KAFKA_TOPIC=raw.museum.ingestion.events.v1
KAFKA_GROUP_ID=address_enricher

# Postgres. 55432 on the host to avoid colliding with a local server.
DATABASE_URL=postgres://museum:museum@127.0.0.1:55432/museum?sslmode=disable

# Contact address sent to Nominatim, whose usage policy requires a descriptive
# User-Agent. Change this before running anything beyond a local experiment.
NOMINATIM_USER_AGENT=museum-pipeline/1.0 (local development)

# Where database dumps are written.
#
# Absolute, and outside the checkout on purpose: this repository is being worked
# on in a git worktree under .claude/worktrees/, so the compose default of
# ./backups would put the backups inside a directory that is meant to be
# deleted — the same mistake that named the Docker volumes after it.
#
# This is still the same physical disk as the volumes it protects. Point it at
# an external drive or a synced folder to survive losing that disk, e.g.
# BACKUP_DIR=/Users/jonathan/Library/Mobile Documents/com~apple~CloudDocs/museum-backups
BACKUP_DIR=/Users/jonathan/Code/museum/backups
